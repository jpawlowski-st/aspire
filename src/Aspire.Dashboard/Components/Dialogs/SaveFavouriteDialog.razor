@using Aspire.Dashboard.Resources

@inject IStringLocalizer<ControlsStrings> Loc

<FluentDialogBody>
    <EditForm EditContext="@_editContext" OnValidSubmit="@SaveAsync">
        <FluentTextInput @ref="_nameField"
                         @bind-Value="_name"
                         Class="aspire-input"
                         Required="true"
                         Maxlength="100"
                         Label="@Loc[nameof(ControlsStrings.SaveFavouriteDialogNameLabel)]"
                         Placeholder="@Loc[nameof(ControlsStrings.SaveFavouriteDialogNamePlaceholder)]"
                         AutoComplete="off"
                         Style="width: 100%" />
        @* Hidden submit so Enter submits the form. *@
        <button type="submit" style="display:none"></button>

        <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.Right" Style="margin-top: 12px;">
            <FluentButton Class="aspire-button" Appearance="ButtonAppearance.Default" Type="ButtonType.Button" OnClick="@CancelAsync">
                @Loc[nameof(ControlsStrings.SaveFavouriteDialogCancelButton)]
            </FluentButton>
            <FluentButton Class="aspire-button" Appearance="ButtonAppearance.Primary" Type="ButtonType.Submit" Disabled="@string.IsNullOrWhiteSpace(_name)">
                @Loc[nameof(ControlsStrings.SaveFavouriteDialogSaveButton)]
            </FluentButton>
        </FluentStack>
    </EditForm>
</FluentDialogBody>
