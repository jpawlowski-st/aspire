@page "/traces/detail/{traceId}"

@using Aspire.Dashboard.Components.Controls.Grid
@using Aspire.Dashboard.Resources
@using System.Diagnostics
@inject IStringLocalizer<StructuredFiltering> FilterLoc
@inject IStringLocalizer<Dialogs> DialogsLoc

<PageTitle>
    <ApplicationName
        AdditionalText="@GetPageTitle()"
        ResourceName="@nameof(Dashboard.Resources.TraceDetail.TraceDetailPageTitle)"
        Loc="@Loc"/>
</PageTitle>

<div class="page-content-container">
    @if (_trace is { } trace)
    {
        <AspirePageContentLayout
            AddNewlineOnToolbar="true"
            MobileToolbarButtonText="@Loc[nameof(Dashboard.Resources.TraceDetail.TraceDetailMobileToolbarButtonText)]"
            IsSummaryDetailsViewOpen="@(SelectedData is not null)"
            HideDesktopToolbar="@ViewportInformation.IsDesktop"
            @ref="@_layout">
            <PageTitleSection>
                <h1 class="page-header">
                    <span>@GetPageTitle()</span>
                    <span class="trace-id">@OtlpHelpers.ToShortenedId(trace.TraceId)</span>
                </h1>
            </PageTitleSection>
            <ToolbarSection>
                @if (!ViewportInformation.IsDesktop)
                {
                    <FluentTextInput TextInputType="TextInputType.Search" @bind-Value="PageViewModel.Filter"
                                  Class="toolbar-search"
                                  @bind-Value:after="HandleAfterFilterBindAsync"
                                  Name="spans-search"
                                  AutoComplete="off"
                                  Immediate="true"
                                  ImmediateDelay="@FluentUIExtensions.InputDelay"
                                  Placeholder="@ControlStringsLoc[nameof(ControlsStrings.FilterPlaceholder)]"
                                  title="@Loc[nameof(Dashboard.Resources.Traces.TracesNameFilter)]">
                        <StartTemplate>
                            <FluentIcon Value="@(new Icons.Regular.Size16.Search())" Color="Color.Primary" />
                        </StartTemplate>
                    </FluentTextInput>
                    <SpanTypeSelect @bind-SpanType="@PageViewModel.SelectedSpanType"
                                    SpanTypes="@_spanTypes"
                                    HandleSelectedSpanTypeChangedAsync="@HandleSelectedSpanTypeChangedAsync" />
                    @if (PageViewModel.Filters.Count > 0)
                    {
                        <div>
                            <FluentCounterBadge Count="@(PageViewModel.Filters.GetEnabledFilters().Count())" ShowEmpty="false" Appearance="BadgeAppearance.Filled">
                                <AnchorContent>
                                    <AspireMenuButton HideIcon="true" Text="@FilterLoc[nameof(StructuredFiltering.Filters)]" ItemsProvider="GetFilterMenuItems" />
                                </AnchorContent>
                            </FluentCounterBadge>
                        </div>
                    }
                    <FluentButton Appearance="ButtonAppearance.Default" aria-label="@FilterLoc[nameof(StructuredFiltering.AddFilter)]" OnClick="() => OpenFilterAsync(null)">
                        <FluentIcon Class="align-text-bottom" Value="@(new Icons.Regular.Size20.Filter())" Color="Color.Primary" /> @FilterLoc[nameof(StructuredFiltering.AddFilter)]
                    </FluentButton>
                    <AspireMenuButton ButtonAppearance="ButtonAppearance.Transparent"
                                      Icon="@(new Icons.Regular.Size20.Options())"
                                      ItemsProvider="@(() => _traceActionsMenuItems)"
                                      Title="@ControlStringsLoc[nameof(ControlsStrings.ActionsButtonText)]"
                                      Text="@ControlStringsLoc[nameof(ControlsStrings.ActionsButtonText)]"/>
                }
            </ToolbarSection>
            <MainSection>
                <SummaryDetailsView
                    ShowDetails="SelectedData is not null"
                    OnDismiss="@(() => ClearSelectedSpanAsync(causedByUserAction: true))"
                    ViewKey="TraceDetail"
                    SelectedValue="@SelectedData"
                    OnResize="@(r => _manager.SetWidthFraction(r.Orientation == Orientation.Horizontal ? r.Panel1Fraction : 1))">
                    <DetailsTitleTemplate>
                        @{
                            string? title = null;
                            string? subtitle = null;

                            if (context?.SpanViewModel is { } spanVm)
                            {
                                title = spanVm.Title;
                                subtitle = OtlpHelpers.ToShortenedId(spanVm.Span.SpanId);
                            }
                            else if (context?.LogEntryViewModel is { } logEntryVm)
                            {
                                title = StructureLogsDetailsViewModel.GetEventName(logEntryVm.LogEntry, StructuredLogsLoc);
                                subtitle = logEntryVm.LogEntry.Scope.Name;
                            }
                        }

                        <div class="pane-details-title" title="@($"{title} ({subtitle})")">
                            @title
                            <span class="pane-details-subtext">@subtitle</span>
                        </div>
                    </DetailsTitleTemplate>
                    <Summary>
                        <div class="trace-summary-layout">
                            @if (ViewportInformation.IsDesktop)
                            {
                                @GetDesktopToolbar()
                            }
                            else
                            {
                                <div class="trace-details-mobile">
                                    @GetTraceDetailsFragment()
                                </div>
                            }

                            <div id="@ScrollContainerId" class="tracedetails-grid-container" tabindex="0" role="region" aria-label="@Loc[nameof(Dashboard.Resources.TraceDetail.TraceDetailTraceStartHeader)]">
                                <GridColumnManager @ref="_manager" Columns="@_gridColumns">
                                    <AspireFluentDataGrid @ref="_dataGrid"
                                                    Virtualize="true"
                                                    GenerateHeader="DataGridGeneratedHeaderType.Sticky"
                                                    Class="main-grid trace-view-grid enable-row-click"
                                                    ResizableColumns="true"
                                                    ItemsProvider="@GetData"
                                                    TGridItem="TraceDetailRowViewModel"
                                                    RowClass="@GetRowClass"
                                                    ColumnOrder="@_manager.ColumnOrder"
                                                    GridTemplateColumns="@_manager.GetGridTemplateColumns()"
                                                    RowSize="DataGridRowSize.Small"
                                                    OverscanCount="50"
                                                    ShowHover="true"
                                                    ItemKey="@(r => r.Key)"
                                                    OnRowClick="@(r => r.ExecuteOnDefault(d => d.SpanViewModel is { } spanViewModel
                                                        ? OnShowPropertiesAsync(spanViewModel, focusElementId: ScrollContainerId)
                                                        : ToggleSpanLogsAsync(d.LogEntry!)))">
                                    <ChildContent>
                                        <AspireTemplateColumn ColumnId="@NameColumn" ColumnManager="@_manager" Title="@Loc[nameof(Dashboard.Resources.TraceDetail.TraceDetailNameHeader)]" Tooltip="true" TooltipText="@(c => c.SpanViewModel?.GetTooltip(_resources) ?? c.LogEntry?.Message)" Class="expand-col">
                                            @if (context.SpanViewModel is { } nameSpan)
                                            {
                                                var isServerOrConsumer = nameSpan.Span.Kind == OtlpSpanKind.Server || nameSpan.Span.Kind == OtlpSpanKind.Consumer;
                                                var marginLeft = (nameSpan.Depth - 1) * 15;

                                                string spanNameContainerStyle;
                                                if (!isServerOrConsumer)
                                                {
                                                    spanNameContainerStyle = $"margin-left: 5px; border-left-color: {ColorGenerator.Instance.GetColorVariableByKey(GetResourceName(nameSpan.Span.Source))}; border-left-width: 5px; border-left-style: solid; padding-left: 9px;";
                                                }
                                                else
                                                {
                                                    spanNameContainerStyle = string.Empty;
                                                }

                                            <div class="span-overview-container">
                                                <span @onclick:stopPropagation="true" style="margin-left: @(marginLeft)px;" class="main-grid-expand-container @(nameSpan.IsCollapsed ? "main-grid-collapsed" : "main-grid-expanded")">
                                                    @if (nameSpan.Children.Count > 0)
                                                    {
                                                        <FluentButton aria-label="@ControlStringsLoc[nameof(ControlsStrings.ToggleNesting)]" Appearance="ButtonAppearance.Transparent" Class="main-grid-expand-button" OnClick="@(() => OnToggleCollapse(nameSpan))">
                                                            <FluentIcon Icon="Icons.Regular.Size12.ChevronRight" Color="Color.Default" />
                                                        </FluentButton>
                                                    }
                                                </span>
                                                <span class="span-name-container" style="@spanNameContainerStyle">
                                                    @if (isServerOrConsumer)
                                                    {
                                                        <FluentIcon Class="span-kind-icon"
                                                                    Color="Color.Custom"
                                                                    CustomColor="@ColorGenerator.Instance.GetColorVariableByKey(GetResourceName(nameSpan.Span.Source))"
                                                                    Value="@TraceHelpers.TryGetSpanIcon(nameSpan.Span, IconVariant.Filled)"/>
                                                    }

                                                    @if (nameSpan.IsError)
                                                    {
                                                        <FluentIcon Icon="Icons.Filled.Size12.ErrorCircle" Color="Color.Error" Class="trace-tag-icon"/>
                                                    }
                                                    <FluentHighlighter HighlightedText="@PageViewModel.Filter" Text="@nameSpan.Span.GetDisplaySummary()" />
                                                    @if (nameSpan.HasUninstrumentedPeer)
                                                    {
                                                        <span class="uninstrumented-peer">
                                                            @{
                                                                Icon icon;
                                                                if (nameSpan.Span.Attributes.HasKey("db.system"))
                                                                {
                                                                    icon = new Icons.Filled.Size16.Database();
                                                                }
                                                                else if (nameSpan.Span.Attributes.HasKey("messaging.system"))
                                                                {
                                                                    icon = new Icons.Filled.Size16.Mail();
                                                                }
                                                                else
                                                                {
                                                                    icon = new Icons.Filled.Size16.ArrowCircleRight();
                                                                }
                                                            }
                                                            <FluentIcon
                                                                Value="icon"
                                                                Color="Color.Custom"
                                                                CustomColor="@ColorGenerator.Instance.GetColorVariableByKey(nameSpan.UninstrumentedPeer)"
                                                                Class="uninstrumented-peer-icon"/>
                                                            <FluentHighlighter HighlightedText="@PageViewModel.Filter" Text="@nameSpan.UninstrumentedPeer" />
                                                        </span>
                                                    }
                                                </span>
                                                <span @onclick:stopPropagation="true">
                                                    @if (IsGenAISpan(nameSpan))
                                                    {
                                                        <FluentButton Appearance="ButtonAppearance.Transparent"
                                                                    IconOnly="true"
                                                                    Title="@ControlStringsLoc[nameof(ControlsStrings.GenAIDetailsTitle)]"
                                                                    Class="genai-details-button"
                                                                    OnClick="() => OnGenAIClickedAsync(nameSpan.Span)">
                                                            <FluentIcon Icon="Icons.Regular.Size20.Sparkle"
                                                                        Color="Color.Primary" />
                                                        </FluentButton>
                                                    }
                                                </span>
                                            </div>
                                            }
                                            else if (context.LogEntry is { } nameLog)
                                            {
                                                <div class="trace-log-overview" style="margin-left: @(Math.Max(0, context.Depth - 1) * 15)px;">
                                                    <LogLevelColumnDisplay LogEntry="@nameLog" />
                                                    <FluentHighlighter HighlightedText="@PageViewModel.Filter" Text="@(nameLog.EventName ?? string.Empty)" />
                                                    <span class="trace-log-message">@nameLog.Message</span>
                                                </div>
                                            }
                                        </AspireTemplateColumn>
                                        <AspireTemplateColumn ColumnId="@ResourceColumn" ColumnManager="@_manager" Title="@Loc[nameof(Dashboard.Resources.TraceDetail.TraceDetailResourceHeader)]" Tooltip="true" TooltipText="@(c => c.SpanViewModel is { } spanVm ? GetResourceName(spanVm.Span.Source) : c.LogEntry is { } logEntry ? OtlpHelpers.GetResourceName(logEntry.Resource, _resources) : null)" Class="expand-col">
                                            <div class="resource-name">
                                                @if (context.SpanViewModel is { } resourceSpan)
                                                {
                                                    <FluentHighlighter HighlightedText="@PageViewModel.Filter" Text="@GetResourceName(resourceSpan.Span.Source)" />
                                                }
                                                else if (context.LogEntry is { } resourceLog)
                                                {
                                                    @OtlpHelpers.GetResourceName(resourceLog.Resource, _resources)
                                                }
                                            </div>
                                        </AspireTemplateColumn>
                                        <AspireTemplateColumn ColumnId="@TicksColumn" ColumnManager="@_manager">
                                            <HeaderCellItemTemplate>
                                                <div class="ticks">
                                                    @* First column starts at 0. We don't want to display the smallest unit (0μs) because that looks odd. Use the unit from the next column *@
                                                    <div class="tick" style="grid-column: 1;"></div>
                                                    <span class="tick-label" style="grid-column: 1;">@($"0{DurationFormatter.GetUnit(trace.Duration / 4)}")</span>

                                                    <div class="tick" style="grid-column: 2;"></div>
                                                    <span class="tick-label" style="grid-column: 2;">@DurationFormatter.FormatDuration(trace.Duration / 4, CultureInfo.CurrentCulture)</span>

                                                    <div class="tick" style="grid-column: 3;"></div>
                                                    <span class="tick-label" style="grid-column: 3;">@DurationFormatter.FormatDuration(trace.Duration / 4 * 2, CultureInfo.CurrentCulture)</span>

                                                    @* Grid column 4 shows two labels. Hide the left aligned label on mobile to avoid them overlapping *@
                                                    <div class="tick" style="grid-column: 4;"></div>
                                                    @if (_manager.ViewportInformation.IsDesktop)
                                                    {
                                                        <span class="tick-label" style="grid-column: 4;">@DurationFormatter.FormatDuration(trace.Duration / 4 * 3, CultureInfo.CurrentCulture)</span>
                                                    }

                                                    <span class="tick-label end-tick" style="grid-column: 4;">@DurationFormatter.FormatDuration(trace.Duration, CultureInfo.CurrentCulture)</span>
                                                    <div class="tick" style="grid-column: 5;"></div>
                                                </div>
                                            </HeaderCellItemTemplate>
                                            <ChildContent>
                                                <div class="ticks">
                                                    @if (context.SpanViewModel is { } tickSpan)
                                                    {
                                                        var spanColor = ColorGenerator.Instance.GetColorVariableByKey(GetResourceName(tickSpan.Span.Source));
                                                        <div class="span-container" style="position: relative; grid-template-columns: @tickSpan.LeftOffset.ToString("F2", CultureInfo.InvariantCulture)% @tickSpan.Width.ToString("F2", CultureInfo.InvariantCulture)% min-content;">
                                                            <div class="span-bar" style="grid-column: 2; background: @spanColor;"></div>
                                                            <div class="span-bar-label @(tickSpan.LabelIsRight ? "span-bar-label-right" : "span-bar-label-left")">
                                                                <span class="span-bar-label-detail">@SpanWaterfallViewModel.GetTitle(tickSpan.Span, _resources)</span>
                                                                <span>@DurationFormatter.FormatDuration(tickSpan.Span.Duration, CultureInfo.CurrentCulture)</span>
                                                            </div>
                                                        </div>
                                                    }
                                                    else if (context.LogEntry is { } tickLog)
                                                    {
                                                        <div class="trace-log-timestamp-container">
                                                            <div class="trace-log-timestamp @(tickLog.IsError ? "trace-log-timestamp-error" : null)" style="left: @GetLogLeftOffset(tickLog).ToString("F2", CultureInfo.InvariantCulture)%;" title="@FormatHelpers.FormatDateTime(TimeProvider, tickLog.TimeStamp, MillisecondsDisplay.Full, CultureInfo.CurrentCulture)"></div>
                                                        </div>
                                                    }
                                                    <div class="tick" style="grid-column: 1;"></div>
                                                    <div class="tick" style="grid-column: 2;"></div>
                                                    <div class="tick" style="grid-column: 3;"></div>
                                                    <div class="tick" style="grid-column: 4;"></div>
                                                    <div class="tick" style="grid-column: 5;"></div>
                                                </div>
                                            </ChildContent>
                                        </AspireTemplateColumn>
                                        <AspireTemplateColumn ColumnId="@ActionsColumn" ColumnManager="@_manager" Title="@ControlStringsLoc[nameof(ControlsStrings.ActionsColumnHeader)]" Class="no-ellipsis">
                                            <div class="grid-action-container" @onclick:stopPropagation="true">
                                                @if (context.SpanViewModel is { } actionSpan)
                                                {
                                                    <SpanActions SpanViewModel="@actionSpan"
                                                                OnViewDetails="@((focusElementId) => OnShowPropertiesAsync(actionSpan, focusElementId))"
                                                                OnLaunchGenAI="@OnGenAIClickedAsync" />
                                                }
                                                else if (context.LogEntry is { } actionLog)
                                                {
                                                    <StructuredLogActions LogEntry="@actionLog"
                                                                          OnViewDetails="@((focusElementId) => ToggleSpanLogsAsync(actionLog))" />
                                                }
                                            </div>
                                        </AspireTemplateColumn>
                                    </ChildContent>
                                    <EmptyContent>
                                        <FluentIcon Icon="Icons.Regular.Size24.GanttChart" Color="Color.Primary" />&nbsp;@Loc[nameof(Dashboard.Resources.TraceDetail.TraceDetailNoSpans)]
                                    </EmptyContent>
                                    </AspireFluentDataGrid>
                                </GridColumnManager>
                            </div>
                        </div>
                    </Summary>
                    <Details>
                        @if (context?.SpanViewModel is { } spanVm)
                        {
                            <SpanDetails ViewModel="spanVm" CloseCallback="() => ClearSelectedSpanAsync(causedByUserAction: true)" LaunchGenAICallback="@OnGenAIClickedAsync" />
                        }
                        else if (context?.LogEntryViewModel is { } logEntryVm)
                        {
                            <StructuredLogDetails ViewModel="logEntryVm" CloseCallback="() => ClearSelectedSpanAsync(causedByUserAction: true)" />
                        }
                    </Details>
                </SummaryDetailsView>
            </MainSection>
        </AspirePageContentLayout>
    }
    else
    {
        <div class="aspire-empty-content">
            <FluentIcon Icon="Icons.Regular.Size24.GanttChart" Color="Color.Primary" /> &nbsp; @string.Format(Loc[nameof(Dashboard.Resources.TraceDetail.TraceDetailTraceNotFound)], TraceId)
        </div>
    }
</div>

@code {
    private RenderFragment GetDesktopToolbar()
    {
        return @<div class="trace-header main-toolbar">
            @GetTraceDetailsFragment()
            <div class="trace-header-filters filter-toolbar"
                 role="group"
                 aria-label="@ControlStringsLoc[nameof(ControlsStrings.PageToolbarLandmark)]">
                <FluentTextInput TextInputType="TextInputType.Search" @bind-Value="PageViewModel.Filter"
                              Class="toolbar-search"
                              @bind-Value:after="HandleAfterFilterBindAsync"
                              Name="spans-search"
                              AutoComplete="off"
                              Immediate="true"
                              ImmediateDelay="@FluentUIExtensions.InputDelay"
                              Placeholder="@ControlStringsLoc[nameof(ControlsStrings.FilterPlaceholder)]"
                              title="@Loc[nameof(Dashboard.Resources.Traces.TracesNameFilter)]">
                    <StartTemplate>
                        <FluentIcon Value="@(new Icons.Regular.Size16.Search())" Color="Color.Primary" />
                    </StartTemplate>
                </FluentTextInput>

                <div class="toolbar-end">
                    <DesktopToolbarDivider />

                    <SpanTypeSelect
                                    @bind-SpanType="@PageViewModel.SelectedSpanType"
                                    SpanTypes="@_spanTypes"
                                    HandleSelectedSpanTypeChangedAsync="@HandleSelectedSpanTypeChangedAsync" />

                    <DesktopToolbarDivider />

                    @if (PageViewModel.Filters.Count == 0)
                    {
                        <span>@FilterLoc[nameof(StructuredFiltering.NoFilters)]</span>
                    }
                    else
                    {
                        <div>
                            <FluentCounterBadge Count="@(PageViewModel.Filters.GetEnabledFilters().Count())" ShowEmpty="false" Appearance="BadgeAppearance.Filled">
                                <AnchorContent>
                                    <AspireMenuButton HideIcon="true" Text="@FilterLoc[nameof(StructuredFiltering.Filters)]" ItemsProvider="GetFilterMenuItems" />
                                </AnchorContent>
                            </FluentCounterBadge>
                        </div>
                    }

                    <DesktopToolbarDivider />

                    <FluentButton Appearance="ButtonAppearance.Default" Class="toolbar-button" aria-label="@FilterLoc[nameof(StructuredFiltering.AddFilter)]" OnClick="() => OpenFilterAsync(null)"><FluentIcon Value="@(new Icons.Regular.Size20.Filter())" Color="Color.Primary" /></FluentButton>

                    <DesktopToolbarDivider />

                    <AspireMenuButton ButtonAppearance="ButtonAppearance.Default"
                                      ButtonClass="toolbar-button"
                                      Icon="@(new Icons.Regular.Size20.Options())"
                                      ItemsProvider="@(() => _traceActionsMenuItems)"
                                      Title="@ControlStringsLoc[nameof(ControlsStrings.ActionsButtonText)]" />
                </div>
            </div>
        </div>;
    }

    private RenderFragment GetTraceDetailsFragment()
    {
        var trace = _trace;
        Debug.Assert(trace is not null, "Trace should be available here");

        var items = GetTraceDetailItems(trace);

        return @<FluentOverflow TItem="TraceDetailItem" Items="@items" Class="trace-header-details">
            <ItemTemplate Context="item">
                <div>
                    @item.Name <strong title="@item.Tooltip">@item.Value</strong>
                </div>
            </ItemTemplate>
            <MoreTemplate Context="overflow">
                <FluentBadge Class="trace-header-overflow-badge"
                             Style="min-width: 32px; max-width: 32px;"
                             Appearance="BadgeAppearance.Filled"
                             Color="BadgeColor.Subtle">+@overflow.OverflowCount</FluentBadge>
            </MoreTemplate>
            <OverflowTemplate Context="overflow">
                <FluentTooltip UseTooltipService="false" Anchor="@overflow.IdMoreButton"
                               Class="trace-header-tooltip">
                    @foreach (var item in overflow.Items)
                    {
                        <div style="margin: 5px;" title="@item.Tooltip">@item.Name <strong>@item.Value</strong></div>
                    }
                </FluentTooltip>
            </OverflowTemplate>
        </FluentOverflow>;
    }
}
